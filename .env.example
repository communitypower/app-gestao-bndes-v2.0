# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados (PostgreSQL)
DATABASE_URL=postgres://usuario:senha@localhost:5432/estudo_bndes?sslmode=require

# Autenticação e Segurança
JWT_SECRET=dev_jwt_secret_key_estudo_bndes_2026

# Integrações opcionais (Manus / Forge / Google Drive / WhatsApp)
VITE_APP_ID=estudo-bndes
OAUTH_SERVER_URL=
OWNER_OPEN_ID=local_admin
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Servidor MCP bndes-naval-mcp (Streamable HTTP; SSE como fallback)
BNDES_NAVAL_MCP_URL=
BNDES_NAVAL_MCP_TOKEN=
# Lista opcional, separada por vírgula, das ferramentas liberadas no portal (vazio = todas)
BNDES_NAVAL_MCP_ALLOWED_TOOLS=
